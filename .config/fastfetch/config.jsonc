{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Logo: usa el logo elegido al azar en .config/fastfetch/logo/, mostrado
  // como imagen real via el protocolo grafico de kitty (no ascii-art).
  "logo": {
    "source": "\"$(hyde-shell fastfetch logo --local)\"",
    "type": "kitty",
    "height": 28
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "title",
    "separator",

    // --- Sistema (rojo) -------------------------------------------------
    { "type": "custom", "format": "\u001b[31m── Sistema ──────────────────\u001b[0m" },
    { "type": "os", "key": "│  OS", "format": "{3}", "keyColor": "red" },
    { "type": "kernel", "key": "│  Kernel", "format": "{2}", "keyColor": "red" },
    { "type": "packages", "key": "│  Packages", "keyColor": "red" },
    { "type": "terminal", "key": "│  Terminal", "keyColor": "red" },
    { "type": "terminalfont", "key": "│  Terminal Font", "keyColor": "red" },
    { "type": "shell", "key": "│  Shell", "keyColor": "red" },
    { "type": "custom", "format": "\u001b[31m╰─\u001b[0m" },

    // --- Escritorio (morado) ---------------------------------------------
    { "type": "custom", "format": "\u001b[35m── Escritorio ───────────────\u001b[0m" },
    { "type": "lm", "key": "│  Display Manager", "format": "{2} {3}", "keyColor": "magenta" },
    { "type": "wm", "key": "│  Window Manager", "format": "{2} ({3})", "keyColor": "magenta" },
    { "type": "theme", "key": "│  Theme", "keyColor": "magenta" },
    { "type": "icons", "key": "│  Icons", "keyColor": "magenta" },
    { "type": "font", "key": "│  Font", "keyColor": "magenta" },
    { "type": "custom", "format": "\u001b[35m╰─\u001b[0m" },

    // --- Antiguedad / Uptime (cyan) --------------------------------------
    { "type": "custom", "format": "\u001b[36m── Antiguedad / Uptime ──────\u001b[0m" },
    { "type": "disk", "key": "│  OS Age", "folders": "/", "format": "{days} dias", "keyColor": "cyan" },
    { "type": "uptime", "key": "│  Uptime", "keyColor": "cyan" },
    { "type": "custom", "format": "\u001b[36m╰─\u001b[0m" },

    // --- Hardware (amarillo) ---------------------------------------------
    { "type": "custom", "format": "\u001b[33m── Hardware ─────────────────\u001b[0m" },
    { "type": "chassis", "key": "│  Equipo", "format": "{2} {3}", "keyColor": "yellow" },
    { "type": "cpu", "key": "│  CPU", "format": "{1} ({3}) @ {7}", "keyColor": "yellow" },
    { "type": "gpu", "key": "│  GPU", "format": "{2}", "keyColor": "yellow" },
    { "type": "display", "key": "│  Pantalla", "format": "{1}x{2} @ {3}Hz [{7}]", "keyColor": "yellow" },
    { "type": "memory", "key": "│  Memoria", "keyColor": "yellow" },
    { "type": "swap", "key": "│  Swap", "keyColor": "yellow" },
    { "type": "battery", "key": "│  Bateria", "keyColor": "yellow" },
    { "type": "custom", "format": "\u001b[33m╰─\u001b[0m" },

    // --- Almacenamiento (verde) -------------------------------------------
    { "type": "custom", "format": "\u001b[32m── Almacenamiento ───────────\u001b[0m" },
    { "type": "disk", "key": "│  / ", "folders": "/", "keyColor": "green" },
    { "type": "disk", "key": "│  /home", "folders": "/home", "keyColor": "green" },
    { "type": "custom", "format": "\u001b[32m╰─\u001b[0m" },

    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
