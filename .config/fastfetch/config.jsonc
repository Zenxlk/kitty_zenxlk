{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Logo: usa el logo de Arch/HyDE, mostrado como imagen real via el
  // protocolo grafico de kitty (no ascii-art).
  "logo": {
    "source": "\"$(hyde-shell fastfetch logo --local)\"",
    "type": "kitty",
    "height": 18
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    // --- Grupo rojo: identidad del sistema ----------------------------
    {
      "type": "custom",
      "format": "\u001b[31m●●●●●●●●●●●●●●●●●●●●\u001b[0m"
    },
    { "type": "os", "key": "  OS", "format": "{3}", "keyColor": "red" },
    { "type": "kernel", "key": "  Kernel", "format": "{2}", "keyColor": "red" },
    { "type": "uptime", "key": "  Uptime", "keyColor": "red" },

    // --- Grupo morado: entorno de shell --------------------------------
    {
      "type": "custom",
      "format": "\u001b[35m♦♦♦♦♦♦♦♦♦♦♦♦♦♦♦♦♦♦♦♦\u001b[0m"
    },
    { "type": "wm", "key": "  WM", "format": "{2}", "keyColor": "magenta" },
    { "type": "packages", "key": "  Packages", "keyColor": "magenta" },
    { "type": "shell", "key": "  Shell", "keyColor": "magenta" },

    // --- Grupo amarillo: hardware --------------------------------------
    {
      "type": "custom",
      "format": "\u001b[33m▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲\u001b[0m"
    },
    { "type": "cpu", "key": "  CPU", "format": "{1} ({3}) @ {7}", "keyColor": "yellow" },
    { "type": "gpu", "key": "  GPU", "format": "{2}", "keyColor": "yellow" },
    { "type": "memory", "key": "  Memory", "keyColor": "yellow" },

    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
