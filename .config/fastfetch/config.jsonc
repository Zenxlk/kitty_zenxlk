{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Logo: usa el logo elegido al azar en .config/fastfetch/logo/, mostrado
  // como imagen real via el protocolo grafico de kitty (no ascii-art).
  "logo": {
    "source": "\"$(hyde-shell fastfetch logo --local)\"",
    "type": "kitty",
    "height": 22
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "title",
    "separator",

    // --- Sistema (rojo) -------------------------------------------------
    { "type": "custom", "format": "\u001b[31m── Sistema ──────────────────\u001b[0m" },
    { "type": "os", "key": "│  OS", "format": "{3}", "keyColor": "red" },
    { "type": "terminal", "key": "│  Terminal", "keyColor": "red" },
    { "type": "shell", "key": "│  Shell", "keyColor": "red" },
    { "type": "custom", "format": "\u001b[31m╰─\u001b[0m" },

    // --- Escritorio (morado) ---------------------------------------------
    { "type": "custom", "format": "\u001b[35m── Escritorio ───────────────\u001b[0m" },
    { "type": "wm", "key": "│  Window Manager", "format": "{2} ({3})", "keyColor": "magenta" },
    { "type": "custom", "format": "\u001b[35m╰─\u001b[0m" },

    // --- Hardware (amarillo) ---------------------------------------------
    { "type": "custom", "format": "\u001b[33m── Hardware ─────────────────\u001b[0m" },
    { "type": "cpu", "key": "│  CPU", "format": "{1} ({3}) @ {7}", "keyColor": "yellow" },
    { "type": "gpu", "key": "│  GPU", "format": "{2}", "keyColor": "yellow" },
    { "type": "memory", "key": "│  Memoria", "keyColor": "yellow" },
    { "type": "custom", "format": "\u001b[33m╰─\u001b[0m" },

    // --- Almacenamiento (verde) -------------------------------------------
    { "type": "custom", "format": "\u001b[32m── Almacenamiento ───────────\u001b[0m" },
    { "type": "disk", "key": "│  / ", "folders": "/", "keyColor": "green" },
    { "type": "disk", "key": "│  /home", "folders": "/home", "keyColor": "green" },
    { "type": "custom", "format": "\u001b[32m╰─\u001b[0m" },

    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
